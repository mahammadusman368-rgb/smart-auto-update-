local function showDatabaseManager()
    local folders = {
        {name="Users Profiles", url=base_url_profiles .. ".json", desc="Tamam registered users ka data"},
        {name="Public Rooms", url=base_url_rooms .. ".json", desc="Public chat rooms aur voice notes"},
        {name="Private Chats", url=base_url_private .. ".json", desc="Private chatting ka data"},
        {name="Online Users", url=db_url_online, desc="Live active status data"},
        {name="Admin Settings", url=db_base .. "admin_settings.json", desc="App rules, mic status, passwords"},
        {name="Blocked Users", url=base_url_blocked .. ".json", desc="Blocked logo ki list"},
        {name="Voice Limits", url=base_url_limits .. ".json", desc="Daily voice limit records"}
    }
    
    local opts = {}
    for i, f in ipairs(folders) do table.insert(opts, f.name) end
    table.insert(opts, "Go Back")
    
    local d = AlertDialog.Builder(service)
    d.setTitle("Firebase Database Manager")
    d.setItems(String(opts), {onClick=function(di, w)
        if w == #opts - 1 then showAdminMenu() return end
        local selFolder = folders[w + 1]
        
        tts("Folder ka size calculate ho raha hai...")
        executeHttp("GET", selFolder.url, nil, function(c, r)
            local kbSize = 0
            if c == "200" and r ~= "null" then kbSize = math.floor(string.len(r) / 1024) end
            
            tts(selFolder.name .. " folder, jisme " .. selFolder.desc .. " hota hai. Iska size taqreeban " .. kbSize .. " KB hai.")
            
            local actD = AlertDialog.Builder(service)
            actD.setTitle(selFolder.name)
            actD.setMessage("Description: " .. selFolder.desc .. "\nSize: " .. kbSize .. " KB\n\nKya aap is folder ka data delete karna chahte hain?")
            actD.setPositiveButton("Delete Data", {onClick=function()
                local confD = AlertDialog.Builder(service)
                confD.setTitle("Final Warning")
                confD.setMessage("Yeh action wapas nahi ho sakta. Confirm delete?")
                confD.setPositiveButton("Confirm", {onClick=function()
                    executeHttp("DELETE", selFolder.url, nil, function()
                        tts(selFolder.name .. " ka data delete ho gaya.")
                        showDatabaseManager()
                    end)
                end})
                confD.setNegativeButton("Cancel", {onClick=function() showDatabaseManager() end})
                showDialog(confD)
            end})
            actD.setNegativeButton("Go Back", {onClick=function() showDatabaseManager() end})
            showDialog(actD)
        end)
    end})
    showDialog(d)
end

showAdminMenu = function()
    local opts = {
        "Global Announcement", 
        "Private Broadcast Message", 
        "App Statistics", 
        "Toggle Mic (On/Off)", 
        "Manage Bad Words",
        "Firebase Database Manager (Wipe)",
        "All Registered Users (Edit/Mute/Block)", 
        "Blocked Users List", 
        "App Close (Lock)", 
        "App Open (Unlock)", 
        "Exit Admin Panel"
    }
    local ad = AlertDialog.Builder(service) ad.setTitle("VIP Admin Controls")
    ad.setItems(String(opts), {onClick=function(dialog_in, which)
        if which == 0 then
            local annInput = EditText(service) annInput.setHint("Write Announcement...")
            local annd = AlertDialog.Builder(service) annd.setTitle("Global Announcement") annd.setView(annInput)
            annd.setPositiveButton("Send", {onClick=function()
                local txt = annInput.getText().toString()
                for _, room in ipairs(categories) do
                    local msg = JSONObject() msg.put("sender_id", android_id) msg.put("sender", "[SYSTEM ADMIN]") msg.put("text", "📢 " .. txt) msg.put("hasAudio", false) msg.put("replyTo", "") msg.put("time", os.date("%I:%M %p")) msg.put("timestamp", os.time())
                    executeHttp("POST", base_url_rooms .. room .. "/messages.json", msg.toString(), function() end)
                end
                tts("Announcement sent.") showAdminMenu()
            end}) showDialog(annd)
        elseif which == 1 then
            local bcInput = EditText(service) bcInput.setHint("Write Broadcast to All Inboxes...")
            local bcd = AlertDialog.Builder(service) bcd.setTitle("Private Broadcast") bcd.setView(bcInput)
            bcd.setPositiveButton("Send", {onClick=function()
                local txt = bcInput.getText().toString() if txt=="" then showAdminMenu() return end
                tts("Sending broadcast to everyone...")
                executeHttp("GET", db_url_profiles, nil, function(c, r)
                    if c=="200" and r~="null" then pcall(function()
                        local j = JSONObject(r) local it = j.keys()
                        while it.hasNext() do
                            local uid = it.next()
                            if uid ~= android_id then
                                local chatRoomKey = getPrivateChatKey(android_id, uid)
                                local msgObj = JSONObject() msgObj.put("sender_id", android_id) msgObj.put("sender", "[SYSTEM ADMIN]") msgObj.put("text", "📢 " .. txt) msgObj.put("time", os.date("%I:%M %p")) msgObj.put("timestamp", os.time())
                                executeHttp("POST", base_url_private .. chatRoomKey .. ".json", msgObj.toString(), function() end)
                            end
                        end
                    end) end tts("Broadcast sent successfully.") showAdminMenu()
                end)
            end}) showDialog(bcd)
        elseif which == 2 then 
            tts("Calculating stats...")
            executeHttp("GET", db_url_profiles, nil, function(c1, r1)
                local tUsers = 0 if c1=="200" and r1~="null" then tUsers = JSONObject(r1).length() end
                tts("Total registered users: " .. tUsers) showAdminMenu()
            end)
        elseif which == 3 then
            executeHttp("GET", db_base .. "admin_settings/mic_status.json", nil, function(c, r)
                local current = "true" if c=="200" and r~="null" then current = r:gsub('"', '') end
                local newVal = current == "true" and "false" or "true"
                executeHttp("PUT", db_base .. "admin_settings/mic_status.json", '"' .. newVal .. '"', function()
                    if newVal == "true" then tts("Mic is now ON for all users.") else tts("Mic is now OFF for all users.") end showAdminMenu()
                end)
            end)
        elseif which == 4 then tts("Bad words manager opened.") showAdminMenu()
        elseif which == 5 then showDatabaseManager()
        elseif which == 6 then tts("User list loaded.") showAdminMenu()
        elseif which == 7 then tts("Blocked list loaded.") showAdminMenu()
        elseif which == 8 then executeHttp("PUT", base_url_app_status, '"closed"', function() tts("App closed.") showAdminMenu() end)
        elseif which == 9 then executeHttp("PUT", base_url_app_status, '"open"', function() tts("App opened.") showAdminMenu() end)
        elseif which == 10 then tts("Admin panel closed.") end
    end}) showDialog(ad)
end

