local function loadMessages()
    if not isChatActive or currentRoom == "" then return end
    executeHttp("GET", base_url_rooms .. currentRoom .. "/messages.json", nil, function(code, res)
        if not isChatActive then return end
        if code == "200" and res ~= "null" and res ~= "" then
            pcall(function()
                local json = JSONObject(res)
                local keys = {} local iter = json.keys()
                while iter.hasNext() do table.insert(keys, iter.next()) end table.sort(keys)
                
                local newValues = {} local tempKeys = {}
                local hasNewIncomingMsg = false local justScroll = false local latestSpeak = "" local validMsgCount = 0 
                local now = os.time()
                
                for i, k in ipairs(keys) do
                    local obj = json.getJSONObject(k)
                    local ts = obj.has("timestamp") and obj.getInt("timestamp") or 0
                    
                    if ts > 0 and (now - ts) > EXPIRY_SECONDS then
                        executeHttp("DELETE", base_url_rooms .. currentRoom .. "/messages/" .. k .. ".json", nil, function() end)
                    elseif lastClearedKey == "" or k > lastClearedKey then
                        validMsgCount = validMsgCount + 1
                        local senderID = obj.has("sender_id") and obj.getString("sender_id") or ""
                        local senderName = obj.getString("sender")
                        local text = obj.getString("text")
                        local rep = obj.has("replyTo") and obj.getString("replyTo") or ""
                        local tme = obj.has("time") and obj.getString("time") or ""
                        local hasAudio = obj.has("hasAudio") and obj.getBoolean("hasAudio") or false
                        
                        rawMessages[k] = {sender_id=senderID, senderName=senderName, text=text, replyTo=rep, time=tme, hasAudio=hasAudio, key=k}
                        
                        local dispName = senderName
                        if isAdminName(senderName) then dispName = "[Admin 🧑‍💻] " .. senderName end
                        
                        local displayStr = dispName .. ": "
                        if rep ~= "" then displayStr = displayStr .. "[Replying to " .. rep .. "] " end
                        if hasAudio then displayStr = displayStr .. "🎤 [Voice Message - Tap Options to Play]" else displayStr = displayStr .. text end
                        displayStr = displayStr .. " (" .. tme .. ")"
                        
                        if senderID == android_id then displayStr = displayStr .. " [Sent]" else displayStr = displayStr .. " [Received]" end
                        
                        table.insert(newValues, displayStr) table.insert(tempKeys, k)
                        
                        if not knownKeys[k] then
                            knownKeys[k] = true
                            if senderID == android_id then justScroll = true else
                                hasNewIncomingMsg = true
                                if text:find("📢") then latestSpeak = "Global Announcement: " .. text
                                elseif hasAudio then latestSpeak = dispName .. " ka voice message aaya hai." else latestSpeak = dispName .. " ka message: " .. text end
                            end
                        end
                    else knownKeys[k] = true end
                end
                
                itemKeys = tempKeys itemValues = newValues
                ui.chatList.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, String(itemValues)))
                
                if isFirstLoad then
                    if validMsgCount > 0 then tts("Room loaded. " .. validMsgCount .. " messages available.") else tts("Room loaded. Koi message nahi hai.") end
                    isFirstLoad = false
                elseif hasNewIncomingMsg then beepAndVibrate() tts(latestSpeak) ui.chatList.setSelection(#itemValues - 1)
                elseif justScroll then ui.chatList.setSelection(#itemValues - 1) end
            end)
        end
    end)
end

local function startAutoRefresh()
