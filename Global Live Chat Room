-- ================= LOGIC =================

local function beepAndVibrate()
    pcall(function()
        require "import"
        import "android.media.RingtoneManager"
        local uri = RingtoneManager.getDefaultUri(RingtoneManager.TYPE_NOTIFICATION)
        local ringtone = RingtoneManager.getRingtone(service, uri)
        if ringtone then ringtone.play() end
    end)
end

local function loadMessages()
    if not isChatActive then return end
    executeHttp("GET", db_url_chat, nil, function(code, res)
        if not isChatActive then return end
        if code == "200" and res ~= "null" and res ~= "" then
            local ok, err = pcall(function()
                local json = JSONObject(res)
                local keys = {}
                local iter = json.keys()
                while iter.hasNext() do table.insert(keys, iter.next()) end
                table.sort(keys)
                
                local newValues = {}
                local tempKeys = {}
                local hasNewMsg = false
                local latestSpeak = ""
                local amIMentioned = false
                local validMsgCount = 0 
                
                for i, k in ipairs(keys) do
                    if lastClearedKey == "" or k > lastClearedKey then
                        validMsgCount = validMsgCount + 1
                        local obj = json.getJSONObject(k)
                        local sender = obj.getString("sender")
                        local text = obj.getString("text")
                        local rep = obj.has("replyTo") and obj.getString("replyTo") or ""
                        local tme = obj.has("time") and obj.getString("time") or ""
                        
                        rawMessages[k] = {sender=sender, text=text, replyTo=rep, time=tme}
                        
                        local dispName = sender
                        if sender == adminName then dispName = "[Admin 👑] " .. sender end
                        
                        local displayStr = dispName .. " (" .. tme .. "):\n"
                        if rep ~= "" then displayStr = displayStr .. "Replying to " .. rep .. " -> " end
                        displayStr = displayStr .. text
                        
                        table.insert(newValues, displayStr)
                        table.insert(tempKeys, k)
                        
                        if not knownKeys[k] then
                            knownKeys[k] = true
                            hasNewMsg = true
                            latestSpeak = dispName .. " ne kaha: " .. text
                            if text:find("@" .. currentUsername) then amIMentioned = true end
                        end
                    else
                        knownKeys[k] = true
                    end
                end
                
                itemKeys = tempKeys
                itemValues = newValues
                ui.chatList.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, String(itemValues)))
                
                if isFirstLoad then
                    if validMsgCount == 0 then
                        service.speak("Koi bhi message nahi aaya chat room mein")
                    else
                        service.speak("Chat room mein " .. validMsgCount .. " message aaye hain")
                    end
                    isFirstLoad = false
                elseif hasNewMsg then
                    beepAndVibrate()
                    if amIMentioned then
                        service.speak("Aapko chat mein mention kiya gaya hai!")
                    else
                        if not ttsMuted then service.speak(latestSpeak) end
                    end
                    ui.chatList.setSelection(#itemValues - 1)
                end
            end)
        end
    end)
end

-- REAL-TIME BACKGROUND CHECKING & HEARTBEAT (Every 5 seconds)
local function startAutoRefresh()
    if not isChatActive then return end
    
    -- Apni presence (heartbeat) send karo UNIX timestamp ke sath (30 sec logic ke liye)
    local safeKey = currentUsername:gsub("%s+", "_")
    local current_time = os.time()
    executeHttp("PUT", base_url_online .. safeKey .. ".json", '{"lastActive":'..current_time..'}', function() end)
    
    loadMessages()
    ui_handler.postDelayed(Runnable{run=startAutoRefresh}, 5000)
end

