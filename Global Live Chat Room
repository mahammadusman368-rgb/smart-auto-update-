-- ================= UTILS & SAVE/LOAD LOGIC =================
local function saveProfile(name, loc, bio)
    local fw = FileWriter(profile_file)
    name = name:gsub("\n", " ")
    loc = loc:gsub("\n", " ")
    bio = bio:gsub("\n", " ")
    fw.write(name .. "\n" .. loc .. "\n" .. bio)
    fw.close()
end

local function getProfile()
    local f = File(profile_file)
    if f.exists() then
        local reader = BufferedReader(FileReader(f))
        local n = reader.readLine() or ""
        local l = reader.readLine() or ""
        local b = reader.readLine() or ""
        reader.close()
        return n, l, b
    end
    return "", "", ""
end

local function saveClearedKey(key)
    local fw = FileWriter(clear_key_file)
    fw.write(key)
    fw.close()
end

local function getClearedKey()
    local f = File(clear_key_file)
    if f.exists() then
        local reader = BufferedReader(FileReader(f))
        local key = reader.readLine()
        reader.close()
        return key or ""
    end
    return ""
end

local lastClearedKey = getClearedKey()

local function readFileText(path)
    local f = File(path)
    if not f.exists() then return nil end
    local reader = BufferedReader(FileReader(f))
    local out = {}
    local line = reader.readLine()
    while line do table.insert(out, line) line = reader.readLine() end
    reader.close()
    return table.concat(out, "\n")
end

local function jsonEscape(str)
    if not str then return "" end
    str = tostring(str)
    str = str:gsub("\\", "\\\\")
    str = str:gsub('"', '\\"')
    str = str:gsub("\n", "\\n")
    str = str:gsub("\r", "\\r")
    return str
end

local function executeHttp(method, urlStr, payload, callback)
    local reqId = tostring(os.time()) .. tostring(math.random(1000, 9999))
    local statusFile = temp_dir .. reqId .. ".txt"
    
    thread(function(m_method, m_url, m_payload, m_file)
        require "import"
        import "java.net.URL"
        import "java.io.FileWriter"
        import "java.io.BufferedReader"
        import "java.io.InputStreamReader"
        local JavaString = luajava.bindClass("java.lang.String")
        
        local function writeResult(st, res)
            local fw = FileWriter(m_file)
            fw.write(st .. "\n" .. (res or ""))
            fw.close()
        end
        
        local ok, err = pcall(function()
            local url = URL(m_url)
            local conn = url.openConnection()
            conn.setConnectTimeout(8000)
            conn.setRequestMethod(m_method)
            
            if m_payload then
                conn.setRequestProperty("Content-Type", "application/json")
                conn.setDoOutput(true)
                local os = conn.getOutputStream()
                os.write(JavaString(m_payload).getBytes("UTF-8"))
                os.close()
            end
            
            local code = conn.getResponseCode()
            if code == 200 then
                local stream = conn.getInputStream()
                local reader = BufferedReader(InputStreamReader(stream))
                local result = ""
                local line = reader.readLine()
                while line do result = result .. line line = reader.readLine() end
                reader.close()
                conn.disconnect()
                writeResult("200", result)
            else
                conn.disconnect()
                writeResult(tostring(code), "")
            end
        end)
        if not ok then writeResult("error", "") end
    end, method, urlStr, payload, statusFile)
    
    local function poll(tries)
        tries = tries or 25
        local f = File(statusFile)
        if f.exists() then
            local content = readFileText(statusFile)
            f.delete()
            local nl = content and content:find("\n")
            local st = content
            local res = ""
            if nl then st = content:sub(1, nl - 1) res = content:sub(nl + 1) end
            callback(st, res)
        elseif tries <= 0 then
            callback("timeout", "")
        else
            ui_handler.postDelayed(Runnable{run=function() poll(tries - 1) end}, 400)
        end
    end
    poll()
end

