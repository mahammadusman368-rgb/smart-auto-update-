local function encodeFileToBase64(path)
    local ok, b64 = pcall(function()
        local file = File(path) local len = file.length()
        local java_lang_reflect_Array = luajava.bindClass("java.lang.reflect.Array")
        local java_lang_Byte = luajava.bindClass("java.lang.Byte")
        local buffer = java_lang_reflect_Array.newInstance(java_lang_Byte.TYPE, len)
        local fis = FileInputStream(file) fis.read(buffer) fis.close()
        return Base64.encodeToString(buffer, Base64.NO_WRAP)
    end)
    if ok then return b64 else return "" end
end

