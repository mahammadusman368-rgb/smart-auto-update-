                local j = JSONObject(r)
                local isPending = j.has("pendingDelete") and j.getBoolean("pendingDelete")
                if isPending then
                    local pts = j.has("pendingDeleteTimestamp") and j.getInt("pendingDeleteTimestamp") or 0
                    if os.time() - pts >= DELETE_WAIT_SECONDS then
                        executeHttp("DELETE", base_url_profiles .. android_id .. ".json", nil, function() callback("not_found", nil) end)
                    else callback("pending_delete", j) end
                else 
                    local lastAct = j.has("lastActiveTime") and j.getInt("lastActiveTime") or 0
                    local nm = j.getString("name")
                    if lastAct > 0 and (os.time() - lastAct > 604800) and not isAdminName(nm) then
                        executeHttp("DELETE", base_url_profiles .. android_id .. ".json", nil, function()
                            tts("Aapki profile 7 din se inactive thi, is liye delete ho gayi hai. Nayi profile banayen.")
                            callback("not_found", nil)
                        end)
                    else
                        currentUsername = nm 
