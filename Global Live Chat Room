ui.btnPrivateSend.onClick = function()
    local textData = ui.inputPrivateMessage.getText().toString() if textData == "" then return end
    
    executeHttp("GET", db_base .. "admin_settings/muted_users/" .. android_id .. ".json", nil, function(mc, mr)
        if mc == "200" and mr ~= "null" and mr ~= "" then
            local muteUntil = tonumber(mr) or 0
            if os.time() < muteUntil then tts("Aapko admin ne temporary mute kiya hua hai.") return end
        end
        
        executeHttp("GET", db_base .. "admin_settings/bad_words.json", nil, function(bc, br)
            local hasBadWord = false
            if bc == "200" and br ~= "null" and br ~= "" then pcall(function()
                local j = JSONObject(br) local it = j.keys() local lowerText = textData:lower()
                while it.hasNext() do 
                    local bw = j.getString(it.next()):lower() 
                    if string.find(lowerText, bw, 1, true) then hasBadWord = true break end 
                end
            end) end
            
            if hasBadWord and not isAdminName(currentUsername) then
                tts("Aapka message policy ke khilaf hai. Ghalat ilfaz allow nahi hain.") return
            end
            
            local msgObj = JSONObject() msgObj.put("sender_id", android_id) msgObj.put("sender", currentUsername) msgObj.put("text", textData) msgObj.put("time", os.date("%I:%M %p")) msgObj.put("timestamp", os.time())
            local chatRoomKey = getPrivateChatKey(android_id, currentChatPartnerID) local private_url = base_url_private .. chatRoomKey .. ".json"
            executeHttp("POST", private_url, msgObj.toString(), function(code, res) if code == "200" then tts("Private message sent.") ui.inputPrivateMessage.setText("") loadPrivateMessages() end end)
        end)
    end)
end

