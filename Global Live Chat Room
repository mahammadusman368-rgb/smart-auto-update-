-- ================= ONLINE USERS (Strictly 30 Seconds Logic) =================
ui.btnOnline.onClick = function()
    ui.moreMenuView.setVisibility(View.GONE)
    ui.onlineView.setVisibility(View.VISIBLE)
    service.speak("Online users ki list khul gayi")
    ui.tvOnlineHeader.setText("Total Online Users: Loading...")
    
    executeHttp("GET", db_url_online, nil, function(code, res)
        if code == "200" and res ~= "null" and res ~= "" then
            local ok, err = pcall(function()
                local j = JSONObject(res)
                local users = {}
                currentOnlineUsersList = {} -- Global tracked list
                local it = j.keys()
                local current_time = os.time()
                
                while it.hasNext() do 
                    local rawKey = it.next()
                    local userObj = j.getJSONObject(rawKey)
                    local lastActive = userObj.has("lastActive") and userObj.getInt("lastActive") or 0
                    
                    -- Check: 30 seconds buffer
                    if current_time - lastActive <= 30 then
                        local realName = rawKey:gsub("_", " ")
                        table.insert(users, realName)
                        table.insert(currentOnlineUsersList, rawKey) -- Store safeKey for fetching profile later
                    end
                end
                
                ui.tvOnlineHeader.setText("Total Online Users: " .. #users)
                ui.onlineList.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, String(users)))
            end)
        else
            ui.tvOnlineHeader.setText("Total Online Users: 0")
            ui.onlineList.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, String({})))
        end
    end)
end

ui.btnBackOnline.onClick = function()
    ui.onlineView.setVisibility(View.GONE)
    ui.chatView.setVisibility(View.VISIBLE) 
    service.speak("Back to chat room")
end

-- ================= VIEW OTHER USER'S PROFILE =================
ui.onlineList.onItemClick = function(parent, viewList, position, id)
    local safeKey = currentOnlineUsersList[position + 1]
    if not safeKey then return true end
    
    service.speak("Profile load ho rahi hai")
    
    executeHttp("GET", base_url_profiles .. safeKey .. ".json", nil, function(code, res)
        if code == "200" and res ~= "null" and res ~= "" then
            local pcallOk, err = pcall(function()
                local j = JSONObject(res)
                local n = j.getString("name")
                local l = j.getString("location")
                local b = j.getString("bio")
                
                ui.onlineView.setVisibility(View.GONE)
                ui.otherProfileView.setVisibility(View.VISIBLE)
                
                ui.tvOtherName.setText("Name: " .. n)
                ui.tvOtherLoc.setText("Location: " .. l)
                ui.tvOtherBio.setText("About: " .. b)
                service.speak("Profile open ho gayi")
            end)
        else
            service.speak("Is user ne abhi apni profile online sync nahi ki")
        end
    end)
    return true
end

ui.btnBackFromOtherProfile.onClick = function()
    ui.otherProfileView.setVisibility(View.GONE)
    ui.onlineView.setVisibility(View.VISIBLE)
    service.speak("Back to online users")
end

-- ================= REPLY/COPY/DELETE =================
ui.chatList.onItemClick = function(parent, viewList, position, id)
    local selectedKey = itemKeys[position + 1]
    local rawMsg = rawMessages[selectedKey]
    if not rawMsg then return true end
    
    local d = AlertDialog.Builder(service)
    d.setTitle("Message Options")
    
    local opts = {"Reply", "Copy"}
    if rawMsg.sender == currentUsername or currentUsername == adminName then
        table.insert(opts, "Delete (Unsend)")
    end
    
    d.setItems(String(opts), {onClick=function(d_inter, which)
        local choice = opts[which + 1]
        if choice == "Copy" then
            local cm = service.getSystemService(Context.CLIPBOARD_SERVICE)
            cm.setPrimaryClip(ClipData.newPlainText("chat", rawMsg.text))
            service.speak("Message copy ho gaya")
        elseif choice == "Reply" then
            replyingTo = rawMsg.sender
            ui.replyText.setText("Replying to: " .. replyingTo .. " (Tap to cancel)")
            ui.replyText.setVisibility(View.VISIBLE)
            service.speak("Reply on. Message likhein.")
        elseif choice == "Delete (Unsend)" then
            service.speak("Deleting...")
            executeHttp("DELETE", base_url_chat .. selectedKey .. ".json", nil, function(c, r)
                if c == "200" then service.speak("Message delete ho gaya") loadMessages() end
            end)
        end
    end})
    
    local alertOpt = d.create()
    alertOpt.getWindow().setType(WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY)
    alertOpt.show()
    return true
end

ui.replyText.onClick = function()
    replyingTo = ""
    ui.replyText.setVisibility(View.GONE)
    service.speak("Reply cancel ho gaya")
end