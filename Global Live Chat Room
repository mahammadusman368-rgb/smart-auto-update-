ui.btnMic.onClick = function()
    executeHttp("GET", db_base .. "admin_settings/mic_status.json", nil, function(gc, gr)
        local micOff = false
        if gc == "200" and gr ~= "null" and gr ~= "" then
            local status = gr:gsub('"', '')
            if status == "false" then micOff = true end
        end
        
        if micOff and not isAdminName(currentUsername) then
            tts("Admin ne voice messages temporary band kiye hue hain.") return
        end
        
        executeHttp("GET", db_base .. "admin_settings/muted_users/" .. android_id .. ".json", nil, function(mc, mr)
            if mc == "200" and mr ~= "null" and mr ~= "" then
                local muteUntil = tonumber(mr) or 0
                if os.time() < muteUntil then tts("Aapko admin ne temporary mute kiya hua hai.") return end
            end
            
            checkVoiceLimitFirebase(function(currentCount)
                if currentCount >= 10 then tts("Daily voice limit reached.") return end
                if not isRecording then pcall(function()
                    if mediaRecorder then mediaRecorder.release() end
                    mediaRecorder = luajava.newInstance("android.media.MediaRecorder")
                    mediaRecorder.setAudioSource(1) mediaRecorder.setOutputFormat(2) mediaRecorder.setAudioEncoder(3)
                    mediaRecorder.setAudioEncodingBitRate(192000) mediaRecorder.setAudioSamplingRate(48000) mediaRecorder.setMaxDuration(20000)
                    mediaRecorder.setOutputFile(audio_record_file) mediaRecorder.prepare() mediaRecorder.start()
                    isRecording = true ui.btnMic.setText("Stop") tts("Recording started.")
                    recordLimitRunnable = Runnable{run=function() if isRecording then stopRecordingInternal() end end}
                    ui_handler.postDelayed(recordLimitRunnable, 20000)
                end) else if recordLimitRunnable then ui_handler.removeCallbacks(recordLimitRunnable) recordLimitRunnable = nil end stopRecordingInternal() end
            end)
        end)
    end)
end

