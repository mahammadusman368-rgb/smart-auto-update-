    checkIfBlocked(function(blocked)
        if blocked then tts("Aapko admin ki taraf se block kar diya gaya hai. Rabta karein: " .. myWhatsAppDisplay) callback("blocked", nil) return end
        executeHttp("GET", base_url_profiles .. android_id .. ".json", nil, function(c, r)
