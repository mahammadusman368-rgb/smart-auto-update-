local function listenForChatRequests()
    if currentUsername == "" then return end
    executeHttp("GET", base_url_requests .. android_id .. ".json", nil, function(c, r)
        if c == "200" and r ~= "null" and r ~= "" then pcall(function()
            local j = JSONObject(r)
            local it = j.keys()
            while it.hasNext() do
                local reqId = it.next()
                local reqData = j.getJSONObject(reqId)
                local senderName = reqData.getString("senderName")
                local status = reqData.getString("status")
                
                if status == "pending" then
                    executeHttp("PUT", base_url_requests .. android_id .. "/" .. reqId .. "/status.json", '"notified"', function()
                        tts("Aapko " .. senderName .. " ne private chat ki request bheji hai.")
                        local d = AlertDialog.Builder(service)
                        d.setTitle("Private Chat Request")
                        d.setMessage(senderName .. " aapse private chat karna chahte hain.")
                        d.setPositiveButton("Accept", {onClick=function()
                            executeHttp("PUT", base_url_requests .. reqId .. "/" .. android_id .. "/status.json", '"accepted"', function()
                                tts("Request accept ho gayi.")
                                currentChatPartnerID = reqId
                                currentChatPartnerName = senderName
                                ui.loginView.setVisibility(View.GONE)
                                ui.categoriesView.setVisibility(View.GONE)
                                ui.onlineView.setVisibility(View.GONE)
                                ui.privateChatView.setVisibility(View.VISIBLE)
                                local chatRoomKey = getPrivateChatKey(android_id, currentChatPartnerID)
                                currentPrivateClearedKey = getPrivateClearedKey(chatRoomKey)
                                isPrivateFirstLoad = true isPrivateChatActive = true 
                                loadPrivateMessages() startPrivateAutoRefresh()
                            end)
                        end})
                        d.setNegativeButton("Decline", {onClick=function()
                            executeHttp("PUT", base_url_requests .. reqId .. "/" .. android_id .. "/status.json", '"declined"', function()
                                tts("Request decline kar di.")
                            end)
                        end})
                        showDialog(d)
                    end)
                elseif status == "accepted" then
                    executeHttp("DELETE", base_url_requests .. android_id .. "/" .. reqId .. ".json", nil, function()
                        tts(senderName .. " ne aapki request accept kar li hai. Chat start.")
                        currentChatPartnerID = reqId
                        currentChatPartnerName = senderName
                        ui.onlineView.setVisibility(View.GONE)
                        ui.otherProfileView.setVisibility(View.GONE)
                        ui.privateChatView.setVisibility(View.VISIBLE)
                        local chatRoomKey = getPrivateChatKey(android_id, currentChatPartnerID)
                        currentPrivateClearedKey = getPrivateClearedKey(chatRoomKey)
                        isPrivateFirstLoad = true isPrivateChatActive = true 
                        loadPrivateMessages() startPrivateAutoRefresh()
                    end)
                elseif status == "declined" then
                    executeHttp("DELETE", base_url_requests .. android_id .. "/" .. reqId .. ".json", nil, function()
                        tts(senderName .. " ne aapki request decline kar di hai.")
                    end)
                end
            end
        end) end
    end)
    if isChatActive or currentUsername ~= "" then ui_handler.postDelayed(Runnable{run=listenForChatRequests}, 6000) end
end

