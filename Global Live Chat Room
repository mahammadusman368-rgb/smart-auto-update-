ui.chatList.onItemClick = function(parent, viewList, position, id)
    local selectedKey = itemKeys[position + 1] 
    local rawMsg = rawMessages[selectedKey] 
    if not rawMsg then return true end
    
    local d = AlertDialog.Builder(service) 
    d.setTitle("Options")
    
    local opts = {}
    if rawMsg.audioBase64 ~= "" then 
        table.insert(opts, "Play Audio") 
        table.insert(opts, "Stop Audio") 
    end
    table.insert(opts, "Reply") 
    
    if rawMsg.audioBase64 == "" then 
        table.insert(opts, "Copy") 
    end
    
    if rawMsg.sender == currentUsername or currentUsername == adminName then 
        table.insert(opts, "Delete (Unsend)") 
    end
    
    d.setItems(String(opts), {onClick=function(d_inter, which)
        local choice = opts[which + 1]
        
        if choice == "Play Audio" then
            stopAnyPlayingAudio() 
            pcall(function() 
                service.speak("Audio load ho rahi hai...")
                local bytes = Base64.decode(rawMsg.audioBase64, Base64.NO_WRAP)
                local fos = FileOutputStream(audio_play_file)
                fos.write(bytes)
                fos.flush()
                fos.close()
                
                chatPlayer = luajava.newInstance("android.media.MediaPlayer") 
                chatPlayer.setDataSource(audio_play_file) 
                chatPlayer.prepareAsync()
                local mpListener = luajava.createProxy("android.media.MediaPlayer$OnPreparedListener", { 
                    onPrepared = function(mp) 
                        mp.start() 
                        service.speak("Voice message chal raha hai") 
                    end 
                })
                chatPlayer.setOnPreparedListener(mpListener) 
            end)
            
        elseif choice == "Stop Audio" then 
            stopAnyPlayingAudio() 
            service.speak("Audio stop ho gayi")
            
        elseif choice == "Copy" then 
            service.getSystemService(Context.CLIPBOARD_SERVICE).setPrimaryClip(ClipData.newPlainText("chat", rawMsg.text)) 
            service.speak("Message copy ho gaya")
            
        elseif choice == "Reply" then 
            replyingTo = rawMsg.sender 
            ui.replyText.setText("Replying to: " .. replyingTo .. " (Tap to cancel)") 
            ui.replyText.setVisibility(View.VISIBLE) 
            service.speak("Reply on.")
            
        elseif choice == "Delete (Unsend)" then 
            service.speak("Deleting...") 
            executeHttp("DELETE", base_url_chat .. selectedKey .. ".json", nil, function(c, r) 
                if c == "200" then 
                    service.speak("Message delete ho gaya") 
                    loadMessages() 
                end 
            end) 
        end
    end})
    
    local alertOpt = d.create() 
    alertOpt.getWindow().setType(WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY) 
    alertOpt.show()
    return true
end

