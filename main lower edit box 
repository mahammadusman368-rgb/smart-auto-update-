          local url = "https://api.whatsapp.com/send?phone=" .. whatsappNumber
          local intent = Intent(Intent.ACTION_VIEW)
          intent.setData(Uri.parse(url))
          intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
          ctx.startActivity(intent)
        end)
        if not success then speakText("WhatsApp open nahi ho saka.") end
      end
    }
    
    btnSubBack.setOnClickListener{
      onClick = function(view) supportDialog.dismiss() end
    }
  end
}

btnGoBack.setOnClickListener{
  onClick = function(v)
    if mainDialog then mainDialog.dismiss() end
  end
}